# =====================================================================
# AutoPost — environment variables
# Copy to .env.local and fill in real values for local dev.
# All vars are validated at boot (src/lib/env.ts). Set
# SKIP_ENV_VALIDATION=true to bypass during CI builds without secrets.
# =====================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=

# --- Social platform OAuth ---
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Internal ---
# Used to authenticate Vercel Cron requests. Generate: openssl rand -hex 32
CRON_SECRET=
# Shared password for the v1 admin gate. Replaced with Supabase Auth in v2.
ADMIN_PASSWORD=
